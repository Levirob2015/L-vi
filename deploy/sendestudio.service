# Sendestudio als Dienst - damit Studio und oeffentliche Seite dauerhaft laufen.
#
#   sudo python3 -m venv /opt/sendestudio
#   sudo /opt/sendestudio/bin/pip install "git+https://github.com/Levirob2015/L-vi"
#   sudo mkdir -p /var/lib/sendestudio && cd /var/lib/sendestudio
#   sudo /opt/sendestudio/bin/sendestudio init --titel "Mein Sender" --basis-url https://radio.example.de
#   sudo cp deploy/sendestudio.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sendestudio
#
# Der Dienst lauscht nur auf 127.0.0.1:8790. Davor gehoert ein Webserver
# mit HTTPS (z.B. Caddy, siehe SENDESTUDIO.md) - ohne HTTPS erlaubt kein
# Browser die Aufnahme ueber Mikrofon oder Kamera.

[Unit]
Description=Sendestudio - Podcasts, Radio und Dokumentationen
Documentation=https://github.com/Levirob2015/L-vi/blob/main/SENDESTUDIO.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=/var/lib/sendestudio
ExecStart=/opt/sendestudio/bin/sendestudio --config /var/lib/sendestudio/sendestudio.json serve
Restart=on-failure
RestartSec=5s

DynamicUser=yes
StateDirectory=sendestudio
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
